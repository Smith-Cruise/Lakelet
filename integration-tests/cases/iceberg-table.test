-- TEST: iceberg_orders
-- DATABASE: iceberg_db

-- QUERY
SELECT count(*) FROM orders;
-- EXPECTED
count(*)
4

-- QUERY
SELECT id, name
FROM orders
WHERE dt = '2026-06-25'
ORDER BY id;
-- EXPECTED
id,name
1,alice
2,bob

-- QUERY
SELECT dt, sum(amount)
FROM orders
GROUP BY dt
ORDER BY dt;
-- EXPECTED
dt,sum(orders.amount)
2026-06-24,19.30
2026-06-25,30.75

-- QUERY
SHOW CREATE TABLE orders;
-- EXPECTED
definition
CREATE TABLE `moto_glue`.`iceberg_db`.`orders`
(
`id` INT,
`name` STRING,
`amount` DECIMAL(10, 2),
`dt` STRING
)
PARTITIONED BY (`dt`)
USING ICEBERG
LOCATION 's3://lakelet-e2e/warehouse/iceberg_db.db/orders'
