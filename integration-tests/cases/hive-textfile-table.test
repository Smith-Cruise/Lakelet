-- TEST: hive_textfile
-- DATABASE: hive_db

-- QUERY
SELECT arrow_typeof(tiny) AS tiny_type, arrow_typeof(small) AS small_type,
arrow_typeof(integer_col) AS int_type, arrow_typeof(big) AS big_type,
arrow_typeof(real_col) AS float_type, arrow_typeof(double_col) AS double_type,
arrow_typeof(flag) AS bool_type, arrow_typeof(amount) AS decimal_type,
arrow_typeof(wide) AS wide_type, arrow_typeof(fraction) AS fraction_type,
arrow_typeof(name) AS string_type, arrow_typeof(fixed) AS char_type,
arrow_typeof(variable) AS varchar_type,
arrow_typeof(bytes_col) AS binary_type, arrow_typeof(day) AS date_type,
arrow_typeof(ts) AS timestamp_type FROM textfile_types WHERE id = 1;
-- EXPECTED
tiny_type,small_type,int_type,big_type,float_type,double_type,bool_type,decimal_type,wide_type,fraction_type,string_type,char_type,varchar_type,binary_type,date_type,timestamp_type
Int8,Int16,Int32,Int64,Float32,Float64,Boolean,Decimal128(10, 2),Decimal128(38, 0),Decimal128(38, 18),Utf8,Utf8,Utf8,Binary,Date32,Timestamp(µs)

-- QUERY
SELECT id, tiny, small, integer_col, big, real_col, double_col, flag FROM textfile_types ORDER BY id;
-- EXPECTED
id,tiny,small,integer_col,big,real_col,double_col,flag
1,-128,-32768,-2147483648,-9223372036854775808,-1.5,-2.25,true
2,127,32767,2147483647,9223372036854775807,1.5,2.25,false
3,0,0,0,9007199254740993,0.0,0.0,
4,,,,,,,

-- QUERY
SELECT id, amount, wide, fraction FROM textfile_types ORDER BY id;
-- EXPECTED
id,amount,wide,fraction
1,-10.50,-99999999999999999999999999999999999999,-12345678901234567890.123456789012345678
2,99999999.99,99999999999999999999999999999999999999,12345678901234567890.123456789012345678
3,0.00,0,0E-18
4,,,

-- QUERY
SELECT id, name IS NULL AS name_null, length(name) AS name_length,
length(fixed) AS char_length, length(variable) AS varchar_length,
fixed = CASE id WHEN 1 THEN 'ab   ' WHEN 2 THEN 'abcde' WHEN 3 THEN 'a b  ' END AS char_value,
name = '中文' AS unicode_value, variable = 'quote"' AS quote_value
FROM textfile_types ORDER BY id;
-- EXPECTED
id,name_null,name_length,char_length,varchar_length,char_value,unicode_value,quote_value
1,false,2,5,5,true,true,false
2,true,,5,,true,,
3,false,2,5,6,true,false,true
4,true,,,,,,

-- QUERY
SELECT id, day, ts FROM textfile_types ORDER BY id;
-- EXPECTED
id,day,ts
1,1960-01-02,1960-01-02T03:04:05.123456
2,2000-02-29,2000-02-29T00:00:00.000001
3,1970-01-01,1969-12-31T23:59:59.999999
4,,

-- QUERY
SELECT count(*) AS rows, count(name) AS names, count(amount) AS amounts FROM textfile_types;
-- EXPECTED
rows,names,amounts
4,2,3

-- QUERY
SELECT id, void_col, arrow_typeof(void_col) AS null_type FROM textfile_types ORDER BY id;
-- EXPECTED
id,void_col,null_type
1,,Null
2,,Null
3,,Null
4,,Null

-- QUERY
SELECT id, tags IS NULL AS tags_null, attrs IS NULL AS attrs_null,
shipto IS NULL AS shipto_null, lineitems IS NULL AS items_null FROM textfile_nested_orders ORDER BY id;
-- EXPECTED
id,tags_null,attrs_null,shipto_null,items_null
1,true,true,true,true
2,true,true,true,true
3,true,true,true,true
4,true,true,true,true
5,true,true,true,true
6,true,true,true,true

-- QUERY
SELECT arrow_typeof(tags) LIKE 'List(%Utf8%' AS array_type,
arrow_typeof(attrs) LIKE 'Map(%' AS map_type,
arrow_typeof(shipto) LIKE 'Struct(%' AS struct_type,
arrow_typeof(lineitems) LIKE 'List(%Struct(%' AS nested_type FROM textfile_nested_orders WHERE id = 1;
-- EXPECTED
array_type,map_type,struct_type,nested_type
true,true,true,true

