id
42
5998

-- QUERY
SELECT id FROM textfile_scan WHERE id IN (42, 2500, 5998) AND length(name) > 2 ORDER BY id;
-- EXPECTED
id
2500
5998

-- QUERY
SELECT id FROM textfile_scan WHERE id = 42 OR (length(name) > 2 AND id IN (2500, 5998)) ORDER BY id;
