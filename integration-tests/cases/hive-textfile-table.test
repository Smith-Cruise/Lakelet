id
42
5998

-- QUERY
SELECT id FROM textfile_scan WHERE id >= 5997 AND NOT (id = 5998) ORDER BY id;
-- EXPECTED
id
5997
5999

-- QUERY
SELECT id FROM textfile_scan WHERE CAST(id AS BIGINT) >= 5998 ORDER BY id;
-- EXPECTED
id
5998
5999

-- QUERY
SELECT id FROM textfile_scan WHERE CAST(id AS VARCHAR) = '2500' ORDER BY id;
-- EXPECTED
id
2500

-- QUERY
-- Known incorrect result tracked in https://github.com/Smith-Cruise/Lakelet/issues/50.
-- DataFusion removes the lossy CAST; the correct IDs are 5997, 5998, 5999.
-- Expect the current empty result so an upstream fix fails this case.
SELECT id FROM textfile_scan WHERE id >= 5997 AND CAST(amount AS INT) = 59 ORDER BY id;
-- EXPECTED
id

-- QUERY
SELECT id FROM textfile_scan WHERE amount > 59.97 AND flag = true ORDER BY id;
-- EXPECTED
id
5998

