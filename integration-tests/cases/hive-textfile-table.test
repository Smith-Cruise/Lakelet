-- QUERY
SELECT count(*) >= 3 AS multiple_files,
sum(CASE WHEN file_path LIKE '%/_hidden/%' OR file_path LIKE '%/_SUCCESS' THEN 1 ELSE 0 END) AS hidden_files,
min(file_size) > 0 AS non_empty FROM `textfile_scan$data_files`;
-- EXPECTED
multiple_files,hidden_files,non_empty
true,0,true

-- QUERY
SELECT count(*) AS partitions,
sum(CASE WHEN data_file_count = 0 THEN 1 ELSE 0 END) AS empty_partitions,
min(total_data_file_size) AS minimum_size FROM `textfile_partitions$partitions`;
-- EXPECTED
partitions,empty_partitions,minimum_size
8,1,0

-- QUERY
SELECT count(*) AS partitions FROM `textfile_empty$partitions`;
-- EXPECTED
partitions
0

-- QUERY
SHOW CREATE TABLE textfile_partitions;
-- EXPECTED
definition
CREATE TABLE `moto_glue`.`hive_db`.`textfile_partitions`
(
`id` Int32,
`name` Utf8,
`amount` Decimal128(10, 2),
`dt` Date32,
`bucket` Int32,
`region` Utf8,
`price` Decimal128(6, 2)
)
PARTITIONED BY (`dt`, `bucket`, `region`, `price`)
USING HIVE
LOCATION 's3://lakelet-e2e/warehouse/hive_db.db/textfile_partitions'

